# Database - Vercel Prisma Storage
# PRISMA_DATABASE_URL (prisma+postgres://) is used for CLI + app (HTTPS).
# DATABASE_URL / POSTGRES_URL are TCP to db.prisma.io:5432 and often fail locally.
DATABASE_URL=
PRISMA_DATABASE_URL=
POSTGRES_URL=

# Admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXTAUTH_SECRET=

# Contact form + new-post notices
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a verified Resend sender to mail subscribers. onboarding@resend.dev can only reach the account owner.
CONTACT_FROM_EMAIL=

# Optional
MAINTENANCE_MODE=

# Studio file uploads (Cloudinary free tier)
# Dashboard -> Programmable Media -> copy cloud name, API key, API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI generation (content pipeline) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BLOG_MODEL=claude-sonnet-4-6
ANTHROPIC_SOCIAL_MODEL=claude-haiku-4-5
GOOGLE_AI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_CRITIC_MODEL=gemini-3.6-flash

# --- LinkedIn (personal profile, w_member_social) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX
LINKEDIN_API_VERSION=202601

# --- Pipeline control ---
CRON_SECRET=
PIPELINE_ENABLED=true
PIPELINE_AUTO_PUBLISH=true
# Soft weekly cadence: 1-2 strong posts/week (see lib/pipeline/schedule.ts MODE_TARGETS).
PIPELINE_POSTS_PER_WEEK_MIN=1
PIPELINE_POSTS_PER_WEEK_MAX=2
# Random delay before blog goes live (hours after generate).
PIPELINE_BLOG_DELAY_MIN_HOURS=1
PIPELINE_BLOG_DELAY_MAX_HOURS=36
# Random gap after blog before LinkedIn (hours).
PIPELINE_LINKEDIN_DELAY_MIN_HOURS=1
PIPELINE_LINKEDIN_DELAY_MAX_HOURS=20
# Brief pillar mix (relative weights; selection is random + anti-streak).
PIPELINE_WEIGHT_BUILD=35
PIPELINE_WEIGHT_BUSINESS=50
PIPELINE_WEIGHT_TIMELY=5
PIPELINE_WEIGHT_CODE_CARD=10
PIPELINE_SEO_ENABLED=true
PIPELINE_SEO_CANNIBAL_BLOCK=true
PIPELINE_SEO_OPPORTUNITY_PREFER=true
PIPELINE_SEO_OPPORTUNITY_MIN_PRIORITY=75
CRITIC_MIN_SCORE=78
# Below this critic score a post is held for review even with auto-publish on.
CRITIC_HARD_FLOOR=60
# --- Variety / randomization (all optional, defaults in lib/pipeline/config.ts) ---
# Author timezone. Every human-shaped publish hour is drawn in this zone.
PIPELINE_TIMEZONE=Asia/Karachi
# Pin to a past run's seed to reproduce its exact editorial plan. Empty = fresh.
PIPELINE_VARIETY_SEED=
# How many recent posts each dimension must differ from.
PIPELINE_VARIETY_WINDOW=5
# Week cadence modes: quiet|normal|burst as relative weights.
PIPELINE_WEEK_MODE_WEIGHTS=quiet:12,normal:72,burst:16
# Minimum hours between two pipeline blogs going live (drawn in this range).
PIPELINE_MIN_GAP_HOURS_MIN=5
PIPELINE_MIN_GAP_HOURS_MAX=30
PIPELINE_MAX_PER_DAY=1
# Hard anti-silence floor: never go quieter than this, whatever the dice say.
PIPELINE_MAX_SILENT_DAYS=6
# Word-count bands as relative weights.
PIPELINE_LENGTH_BANDS=short-take:10,standard:45,long:30,deep-dive:15
# Inline image count weights (0 to 4).
PIPELINE_IMAGE_COUNT_WEIGHTS=0:8,1:17,2:35,3:30,4:10
# Cover mode weights: ai (Gemini metaphor) vs og (Satori typographic card).
PIPELINE_COVER_MODE_WEIGHTS=ai:75,og:25
# Blog model rotation weights. Keys must be real model ids.
PIPELINE_MODEL_WEIGHTS=claude-sonnet-4-6:70,claude-opus-5-5:20,claude-haiku-5-5:10
ANTHROPIC_BLOG_DEEP_MODEL=claude-opus-5-5
ANTHROPIC_BLOG_FAST_MODEL=claude-haiku-5-5
# Temperature jitter. Only applied to models that accept temperature at all
# (see lib/pipeline/model-capabilities.ts); others get a drawn effort instead.
PIPELINE_TEMP_MIN=0.75
PIPELINE_TEMP_MAX=1.0
# Probability a draft gets a tightening second pass.
PIPELINE_SECOND_PASS_PROB=0.25
# Probability a published blog gets a LinkedIn companion post at all.
PIPELINE_LINKEDIN_ATTACH_PROB=0.78
# Content refresh loop.
PIPELINE_REFRESH_MIN_AGE_DAYS=90
PIPELINE_REFRESH_PER_WEEK=1

# --- Author identity (E-E-A-T: a named human, not a generated avatar) ---
PIPELINE_AUTHOR_NAME=Ali Raza
PIPELINE_AUTHOR_ROLE=Senior Full Stack Engineer, Twixr Solutions
PIPELINE_AUTHOR_IMAGE=/ali-raza.jpg

# --- IndexNow (Bing / Copilot push indexing) ---
# The matching key file already exists at
# public/aa48e6025c024443ab0da9b87b50ae62.txt. Set this on Vercel to switch
# submission on; empty means every submit silently no-ops.
INDEXNOW_KEY=aa48e6025c024443ab0da9b87b50ae62

PIPELINE_NOTIFY_TO=
COVER_IMAGE_MODE=ai
# ai = Gemini cover with random Twixr brand styles (recommended).
# og = branded Satori text card (fallback if Gemini images are unavailable).
# Inline images always use Gemini + a random brand style per image.
# PIPELINE_AUTO_PUBLISH=true skips needs_review and schedules LinkedIn automatically.
# PIPELINE_X_MANUAL=true (default) generates X drafts for /admin/x (manual post, no X API).
# PIPELINE_SEO_ENABLED=true (default) inventory + cannibalization + verified internal links + SEO report.
# PIPELINE_SEO_CANNIBAL_BLOCK=true (default) skips briefs that near-duplicate existing posts.
# PIPELINE_SEO_OPPORTUNITY_PREFER=true (default) promotes high-score content-gap topics ahead of topic-bank.
# PIPELINE_SEO_OPPORTUNITY_MIN_PRIORITY=75 minimum score to prefer an opportunity over the bank.
# Soft SEO score is logged/emailed and does not block publish; hard fails (invented URLs, empty meta) do.
# Wave 4: contentCluster persisted on BlogPost; related posts use cluster/tags; orphan/broken audits log-only.
# Wave 5: depth/format/voice/news guidance in blog prompts; soft depth band in SEO score (no padding gate).
# Admin manual generate: /admin/blog/generate uses the same SEO pipeline (skip cadence/today guards).
# Manual generate (bypass weekly roll): GET /api/cron/generate?force=1
# Publish-due runs on both crons and flips blogs when publishAt is due.
