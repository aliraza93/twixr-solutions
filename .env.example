# Database - Vercel Prisma Storage
# PRISMA_DATABASE_URL (prisma+postgres://) is used for CLI + app (HTTPS).
# DATABASE_URL / POSTGRES_URL are TCP to db.prisma.io:5432 and often fail locally.
DATABASE_URL=
PRISMA_DATABASE_URL=
POSTGRES_URL=

# Admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXTAUTH_SECRET=

# Contact form
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional
MAINTENANCE_MODE=

# Studio file uploads (Cloudinary free tier)
# Dashboard -> Programmable Media -> copy cloud name, API key, API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI generation (content pipeline) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BLOG_MODEL=claude-sonnet-4-6
ANTHROPIC_SOCIAL_MODEL=claude-haiku-4-5
GOOGLE_AI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_CRITIC_MODEL=gemini-3.6-flash

# --- LinkedIn (personal profile, w_member_social) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX
LINKEDIN_API_VERSION=202601

# --- Pipeline control ---
CRON_SECRET=
PIPELINE_ENABLED=true
CRITIC_MIN_SCORE=78
PIPELINE_NOTIFY_TO=
COVER_IMAGE_MODE=og
# og = random branded Satori cover (6 Twixr styles). ai = Gemini cover with same random brand styles.
# Inline images always use Gemini + a random brand style per image.
