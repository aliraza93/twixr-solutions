generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  status           String    @default("active") // "active" | "unsubscribed"
  unsubscribeToken String    @unique
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([status])
  @@map("subscribers")
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String   @default("")
  projectType String   @default("")
  message     String
  status      String   @default("unread")
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  date        String
  image       String   @default("")
  category    String   @default("")
  tags        String[]
  readingTime String   @default("")
  author      String   @default("Twixr Solutions")
  authorRole  String   @default("")
  authorImage String   @default("")
  body        String   @default("")
  faqs        Json     @default("[]")
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // pipeline bookkeeping (optional/defaulted so CMS editor stays unchanged)
  origin           String       @default("manual") // "manual" | "pipeline"
  reviewState      String       @default("none") // "none" | "needs_review" | "approved"
  reviewReasons    Json         @default("[]") // string[] of failed checks
  criticScore      Int?
  briefId          String?
  brief            Brief?       @relation(fields: [briefId], references: [id])
  socialPosts      SocialPost[] @relation("BlogToSocial")
  // when set and published=false, publish-due cron flips published at/after this time
  publishAt        DateTime?
  // SEO Wave 4: topical cluster + keyword for related posts / graph
  contentCluster   String       @default("")
  targetKeyword    String       @default("")
  // Set after new-post mail is sent to the subscriber list (once per post).
  newsletterSentAt DateTime?
  // Drawn per post by the variety plan: BlogPosting | TechArticle | HowTo.
  // Varying the schema type is both more accurate per article shape and one
  // less thing that is identical across every post on the site.
  schemaType       String       @default("BlogPosting")
  // Visible "Updated on" date, set by the content refresh loop.
  lastReviewedAt   DateTime?

  @@index([published, sortOrder])
  @@index([reviewState])
  @@index([publishAt, published])
  @@index([contentCluster])
  @@map("blog_posts")
}

model Brief {
  id                 String     @id @default(cuid())
  pillar             String // "Build/Laravel", "Timely", "Business/Upwork", ...
  topic              String // short specific phrase
  targetKeyword      String     @default("")
  angle              String     @default("")
  realExample        String     @default("") // optional real, verified detail. Never fabricated.
  requiresLiveSource Boolean    @default(false) // true for Timely/news briefs -> forces web verification
  status             String     @default("queued") // "queued" | "used" | "skipped"
  scheduledFor       DateTime?
  usedAt             DateTime?
  // Manual generate / provenance
  origin             String     @default("topic-bank") // topic-bank | opportunity | manual
  sourceUrl          String     @default("")
  formatHint         String     @default("")
  extraInstructions  String     @default("")
  posts              BlogPost[]
  createdAt          DateTime   @default(now())

  @@index([status, scheduledFor])
  @@index([origin])
  @@map("briefs")
}

model SocialPost {
  id            String    @id @default(cuid())
  channel       String    @default("linkedin")
  blogPostId    String?
  blogPost      BlogPost? @relation(fields: [blogPostId], references: [id], name: "BlogToSocial")
  body          String // exact text to post, <= 3000 chars
  imageUrl      String    @default("") // Cloudinary URL, optional
  visibility    String    @default("PUBLIC") // "PUBLIC" | "CONNECTIONS"
  status        String    @default("scheduled") // "scheduled" | "needs_review" | "manual" | "published" | "failed"
  reviewReasons Json      @default("[]")
  criticScore   Int?
  scheduledFor  DateTime // ~12h after the blog publishes
  publishedAt   DateTime?
  externalId    String? // urn:li:share:... on success
  failReason    String    @default("")
  createdAt     DateTime  @default(now())

  @@index([status, scheduledFor])
  @@map("social_posts")
}

model GenerationLog {
  id        String   @id @default(cuid())
  runId     String // groups all rows from one cron invocation
  stage     String // "brief" | "blog" | "images" | "critic" | "validate" | "linkedin" | "publish" | "notify" | "seo"
  status    String // "ok" | "warn" | "fail" | "skip"
  refType   String   @default("") // "BlogPost" | "SocialPost" | "Brief"
  refId     String   @default("")
  message   String   @default("")
  meta      Json     @default("{}") // tokens, model, cost, scores, urls
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([stage, status])
  @@map("generation_logs")
}

/**
 * SEO Wave 3: post-publish follow-up topics. Prefer high scores over topic-bank FIFO.
 */
model TopicOpportunity {
  id                    String   @id @default(cuid())
  topic                 String
  cluster               String   @default("")
  type                  String   @default("supporting") // pillar | supporting | related | commercial | deep-dive | comparison | faq
  pillar                String   @default("")
  parentTopic           String   @default("")
  parentSlug            String   @default("")
  sourceBlogPostId      String   @default("")
  reason                String   @default("")
  priority              Int      @default(50)
  commercialRelevance   Int      @default(0)
  internalLinkPotential Int      @default(0)
  cannibalizationRisk   Int      @default(0)
  status                String   @default("queued") // queued | promoted | skipped | used
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status, priority])
  @@index([cluster])
  @@map("topic_opportunities")
}

/**
 * Every randomized decision from a pipeline run. Powers the no-repeat window
 * in lib/pipeline/variety/sampler.ts and the variety audit.
 */
model VarietyChoice {
  id         String   @id @default(cuid())
  runId      String
  dimension  String // "publishHour" | "structure" | "palette" | "lengthBand" | ...
  value      String
  blogPostId String   @default("")
  createdAt  DateTime @default(now())

  @@index([dimension, createdAt])
  @@index([runId])
  @@map("variety_choices")
}

/**
 * Per-ISO-week cadence draw. Stable inside the week (a row, not a hash) so
 * every run that week agrees, but not predictable across weeks.
 */
model PipelineWeek {
  id            String   @id @default(cuid())
  weekStart     DateTime @unique // Monday 00:00 UTC
  targetPosts   Int
  mode          String   @default("normal") // "quiet" | "normal" | "burst"
  pillarWeights Json     @default("{}")
  refreshesDone Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("pipeline_weeks")
}

/**
 * Real, verified, anonymized material from Ali's actual work. The generator
 * may only cite first-hand experience that exists in here. Never fabricated.
 */
/**
 * The day's generation decision, drawn once and stored. The cron tick runs
 * every 10 minutes; without this the daily probability would be re-rolled 144
 * times a day and would always fire.
 */
model PipelineDay {
  id    String  @id @default(cuid())
  day   String  @unique // local YYYY-MM-DD in pipeline.timezone
  go    Boolean @default(false)
  // How many posts today may produce. 2 only on burst weeks, so a second
  // same-day post is possible without it ever becoming the pattern.
  slots Int     @default(1)

  generateAt     DateTime? // when the first run may start
  secondAt       DateTime? // when a second run may start, if slots is 2
  generatedCount Int       @default(0)
  reason         String    @default("")
  generatedAt    DateTime? // first claim, kept for reporting
  createdAt      DateTime  @default(now())

  @@map("pipeline_days")
}

model Receipt {
  id         String    @id @default(cuid())
  cluster    String    @default("") // "Laravel", "AWS", "Databases", "Upwork", ...
  kind       String    @default("incident") // incident | number | decision | artifact | client
  summary    String // one line, what happened
  detail     String    @default("") // the specifics: numbers, log lines, query plans
  outcome    String    @default("") // what changed after
  usedCount  Int       @default(0)
  lastUsedAt DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active, cluster])
  @@map("receipts")
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  data      Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model PortfolioProject {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  featured  Boolean  @default(false)
  data      Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("portfolio_projects")
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  title     String   @default("")
  company   String   @default("")
  platform  String   @default("")
  avatar    String   @default("")
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  icon      String   @default("lucide:help-circle")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("faqs")
}

model SiteSettings {
  id        String   @id @default("default")
  site      Json
  hero      Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
